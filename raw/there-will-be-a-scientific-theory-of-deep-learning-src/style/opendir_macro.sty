% \usepackage{emo}
% \let\emoji\emo    % so your existing \emoji{...} calls keep working

% \usepackage{graphicx}
\newcommand{\emoji}[1]{%
  \raisebox{-0.2ex}{\includegraphics[height=1em]{style/emojis/#1.pdf}}%
}

% --- knobs ---
\newcommand{\opendirectionemoji}{} % set per-environment instance

\newlength{\opendirectionvspace}
\setlength{\opendirectionvspace}{1.3\baselineskip} % space BEFORE each opendirection

% -------------------------
% Single style: emoji on the LEFT, head wraps, body starts next line
% -------------------------
\newtheoremstyle{opendirection-style}%
  {3pt}{3pt}% space above/below (fine to leave; real "before" spacing is in the env wrapper below)
  {\normalfont}%
  {0pt}%
  {\bfseries}%
  {}%
  {0pt}% space after head (head consumes full line so body starts next line)
  {%
    \makebox[\linewidth][l]{%
      \parbox[t]{\linewidth}{\raggedright
        \ifstrempty{\opendirectionemoji}{}{\opendirectionemoji\ }%
        \thmname{#1}\ \thmnumber{#2}:%
        \ifstrempty{#3}{}{ \textbf{#3}}%
      }%
    }%
  }%

\theoremstyle{opendirection-style}
\newtheorem{opendirection@thm}{Open Direction}

% -------------------------
% User-facing environment:
%   \begin{opendirection}[Title] ...                 (back-compat)
%   \begin{opendirection}[\emoji{gear}][Title] ...   (emoji + title)
% -------------------------
  \NewDocumentEnvironment{opendirection}{O{} o}
    {%
      \par\addvspace{\opendirectionvspace}%
      \IfNoValueTF{#2}
        {\def\opendirectionemoji{}\def\opendirection@title{#1}}%
        {\def\opendirectionemoji{#1}\def\opendirection@title{#2}}%
      \begin{opendirection@thm}[\opendirection@title]%
    }
    {\end{opendirection@thm}}
